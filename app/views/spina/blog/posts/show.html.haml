%article
  .blog-hero{class: ('has-image' if @post.image.present?)}
    .row.blog-banner.hidden
    .container
      .row.blog-head
        .col-md-12
          %header
            %h1= @post.title
            .details.h4.text-muted
              = @post.user&.name
              &nbsp;&nbsp;
              = '|'
              &nbsp;&nbsp;
              = @post.published_at.strftime("%B %d, %Y")

  .container.blog-body.blog-content
    = post.content&.html_safe

- unless @post.image.blank?
  - content_for :javascripts do
    :javascript
      $(window).load(function () {
        $('.blog-banner').removeClass('hidden').css('background-image', 'url(#{main_app.url_for(@post.image.file)})');
      });

