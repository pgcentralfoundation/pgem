- featured = local_assigns.fetch(:featured, false)

%article.card{class: ('card-featured' if featured)}
  .card-media{class: ('has-image' if post.image.present?)}
    -unless post.image.blank?
      %img.img-responsive.card-img-top{alt: post.title, src: main_app.url_for(post.image.file)}
    %h2.card-title
      = link_to post.title, spina.blog_post_url(post)

  .card-header.text-muted
    .byline-meta
      = post.user&.name
      &nbsp;&nbsp;|&nbsp;&nbsp;
      = post.published_at.strftime("%B %d, %Y")
    - if post.tags.any?
      .card-tags
        - post.tags.each do |tag|
          = link_to tag.name, blog_tagged_posts_path(tag.name), class: 'tag-pill'

  .card-block
    %p.card-text
      - excerpt_source = post.excerpt.presence || post.content
      - unfeatured_excerpt_length = 260
      - excerpt_length = featured ? unfeatured_excerpt_length * 2 : unfeatured_excerpt_length
      = sanitize(excerpt_source, tags: []).truncate(excerpt_length, separator: ' ').html_safe
    = link_to spina.blog_post_url(post), class: 'read-more' do
      Read more →
