.container.blog-head
  .huge
    Blog

.container.blog-body
  - if @posts.any? || @featured_posts.any?
    .row
      .col-md-8
        - if @featured_posts.any?
          = render partial: 'spina/blog/posts/post', collection: @featured_posts, as: :post, locals: { featured: true }
        = render partial: 'spina/blog/posts/post', collection: @posts, as: :post, locals: { featured: false }
      / Blog Sidebar Widgets Column
      .col-md-4
        / Tags
        - @tags = Spina::Blog::Post.all_tag_counts
        - if @tags.any?
          %h4.sidebar-title Tags
          %nav#tags
            - tag_cloud(@tags, %w(tag-quiet tag-common tag-peak)) do |tag, css_class|
              = link_to tag.name, blog_tagged_posts_path(tag.name), class: "tag-pill #{css_class}"
        -# TODO: implement archive links
        -# = blog_archive_widget

    .row
      .col-md-12.text-center
        = will_paginate @posts, renderer: BlogPaginationRenderer
  - else
    %p= t('.no_blog_articles_yet')
