<%= render Spina::MainNavigation::SubNavComponent.new(:team_members) do |nav| %>
  <% nav.with_icon do %>
    <%= heroicon('users', style: :solid, class: 'w-8 h-8 text-white md:mr-3') %>

    <div class="text-white font-semibold hidden md:block transform -translate-x-2 ease-in-out duration-300 absolute md:relative opacity-0 transition-all" data-navigation-target="label">
      Team
    </div>
  <% end %>

  <% nav.with_links do %>
    <%= render Spina::MainNavigation::LinkComponent.new('Team members', spina.admin_team_members_path, active: request.path.start_with?("/#{Spina.config.backend_path}/team_members")) %>
  <% end %>
<% end %>
