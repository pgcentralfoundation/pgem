<%= render Spina::UserInterface::HeaderComponent.new do |header| %>
  <% header.with_actions do %>
    <%= link_to spina.new_admin_team_member_path, class: 'btn btn-default h-8 px-2 ml-3' do %>
      <%= heroicon('plus', style: :solid, class: 'w-6 h-6') %>
    <% end %>
  <% end %>
<% end %>

<div class="p-8">
  <% if @team_members.any? %>
    <div class="shadow-sm border border-gray-200 bg-white rounded-lg" data-controller="team-members-sortable" data-team-members-sortable-target="list">
      <%= form_with url: spina.sort_admin_team_members_path, data: { team_members_sortable_target: "form" } do |f| %>
      <% end %>

      <%= render partial: 'team_member', collection: @team_members, as: :team_member %>
    </div>
  <% else %>
    <div class="text-gray-700 italic">
      No team members yet.
    </div>
  <% end %>
</div>
