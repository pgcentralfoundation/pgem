.pass
  - if devise_mapping.recoverable? && devise_mapping.used_routes.include?(:password) && controller_name != 'passwords'
    = link_to "Forgot your password?", new_password_path(resource_name), class: 'help-link'


  - if devise_mapping.confirmable? && devise_mapping.used_routes.include?(:confirmation) && controller_name != 'confirmations'
    = link_to "Didn't receive confirmation instructions?", new_confirmation_path(resource_name), class: 'help-link'

  - if devise_mapping.lockable? && devise_mapping.used_routes.include?(:unlock) && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks'
    = link_to "Didn't receive unlock instructions?", new_unlock_path(resource_name), class: 'help-link'


  - if devise_mapping.ichain_registerable?
    = link_to "Sign up", new_ichain_registration_path(resource_name), class: 'help-link'
